# Secrets — never tracked. Harbor reads this via --env-file.
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
*.swp

# Local design docs (brainstorming specs / implementation plans) — never tracked or published
docs/superpowers/

# Runtime artifacts from the pr-writeup skill (if ever run inside the repo)
.pr-writeup/
*-writeup.html

# Harbor derived build input. A tier-3 task IS its declaration under
# plugins/lirbox/skills/<skill>/harbor/tasks/<id>/ — Harbor runs that directory directly. The only
# untrackable piece is environment/skill/, the PRUNED copy of the skill the image installs for the
# agent (evals/, harbor/, arena/ stripped, so it cannot read its own graders). Derived from tracked
# files by scripts/harbor-prep.mjs — never committed, because a committed copy goes stale silently.
plugins/lirbox/skills/*/harbor/tasks/*/environment/skill/

# Harbor run output (`harbor run` writes jobs/<job>/<trial>/ with agent logs, verifier
# results and artifacts). Runtime, per-run, often large — never committed.
jobs/

# Build-time scratch left by lane worker agents (delivered only via docs/changes, else dropped)
implementation-notes/

# Per-run orchestration store + run ledger written by the herdr orchestrator
# (dispatch/, evidence/, decisions/, progress/, notes.jsonl, implementation-notes.html).
# Run scratch — the finished ledger is PROMOTED into docs/changes/<run>/ at publish.
.orchestration/

# Generated single-file HTML artifacts (flowchart / codewalk / plan-deck / component / sequence skills)
*-flowchart.html
*-codewalk.html
*-plan-deck.html
*-component.html
*-sequence.html
*-c4.html

# EXCEPTION: the herdr orchestrator's Finish step (via lirbox-docs-writer) PROMOTES a run's
# implementation summary into docs/changes/<name>/ — these ARE tracked, they ride the PR.
# Must come AFTER the filename-globs above so it re-includes anything they would catch.
!docs/changes/
!docs/changes/**

# graphify machine-local pointers — absolute paths to this machine's interpreter
# and scan root, rewritten on every run. The rest of graphify-out/ stays tracked.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cost.json
graphify-out/cache/last_query_stamp

.env

# Python bytecode — rewardkit imports the Harbor graders as modules, so running a task
# verifier locally drops __pycache__ next to checks.py. One copy already reached main this way.
__pycache__/
*.pyc
