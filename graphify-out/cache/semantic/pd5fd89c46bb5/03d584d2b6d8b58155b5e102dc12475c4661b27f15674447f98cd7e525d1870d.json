tion": null, "weight": 1.0}, {"source": "docs_plans_2026_07_27_loom_graph_runtime_fixture_must_match_shipping_shape", "target": "docs_plans_2026_07_27_loom_graph_runtime_non_passing_edge_rule", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-27-loom-graph-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_27_loom_graph_runtime_fixture_must_match_shipping_shape", "target": "contributing_discrimination_gate_nop_oracle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/plans/2026-07-27-loom-graph-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_27_loom_graph_runtime_dead_end_and_orphan_rejection", "target": "docs_plans_2026_07_27_loom_graph_runtime_graph_core", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-27-loom-graph-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_27_loom_graph_runtime_graph_core", "target": "docs_specs_2026_07_27_loom_graph_runtime_design_graph_server", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-27-loom-graph-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_plans_2026_07_27_loom_graph_runtime_graph_core", "target": "docs_specs_2026_07_27_loom_graph_runtime_design_react_flow_editor", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plans/2026-07-27-loom-graph-runtime.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "gate_unbypassable_invariant_argument", "label": "The argument that no path reaches the terminal without crossing every gate", "nodes": ["docs_specs_2026_07_27_loom_graph_runtime_design_invariants_frozen_at_approval", "docs_specs_2026_07_27_loom_graph_runtime_design_st