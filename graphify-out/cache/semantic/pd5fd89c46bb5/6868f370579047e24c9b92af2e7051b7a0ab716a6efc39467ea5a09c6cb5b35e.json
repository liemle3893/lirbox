{"nodes": [{"id": "claude_lirbox_plugin_marketplace", "label": "lirbox plugin marketplace", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_html_artifact_skills", "label": "HTML-artifact skill family", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills that emit one self-contained HTML file share the same delivery contract, so conventions (headless validator over the output) can be shared across them."}, {"id": "claude_orchestration_loop_skills", "label": "Orchestration / loop skill family", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "conductor, prospector, whetstone and arena share one backbone: a deterministic JS conductor driving full-tool worker subagents, so the same hard rules apply to all four."}, {"id": "claude_conductor_layer_purity", "label": "Conductor layer is restricted pure JS", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No fs/git/require/Date.now()/Math.random() in the conductor keeps it deterministic and unit-testable without spawning agents; every side effect is pushed into an agent() worker prompt. Enforced by a string scan in each skill's test-*.cjs."}, {"id": "claude_never_hand_edit_generated_script", "label": "Never hand-edit a generated loop script", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated scripts come from scripts/scaffold-*.cjs; hand-edits reintroduce drift between generator and output, so changes go through the generator and regenerate with --force."}, {"id": "claude_generator_regression_net", "label": "Generator regression net (test-*.cjs)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asserts loop/phase structure plus the no-fs purity scan plus unit helpers, so touching a generator cannot silently break the emitted conductor."}, {"id": "claude_non_destructive_default", "label": "Non-destructive default: PR, never auto-merge", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loop skills run unattended, so a human must review before anything lands: they finalize by opening a PR with the run report as the body, falling back to leaving the branch when there is no remote."}, {"id": "claude_per_run_timestamped_branches", "label": "Per-run timestamped branches keyed by run slug", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "opt/<goal>-<ts> and improve/<skill>-<ts> keyed by run slug (not skill/goal) so concurrent runs never collide over state/config/report/branch/worktree; the whetstone backlog stays keyed by skill."}, {"id": "claude_runtime_artifacts_gitignored", "label": "Runtime artifacts are gitignored", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".workflows/, .optimize/, .improve/, .arena/, .worktrees/, generated HTML and implementation-notes/ are scratch; committing them would pollute history with per-machine state."}, {"id": "claude_delivery_artifact_exception", "label": "Delivery-artifact promotion exception", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "arena's Finalize and conductor's Writeup promote artifacts into docs/arena/** and docs/changes/**, which .gitignore un-ignores so they ride the PR; the scratch dirs themselves stay ignored."}, {"id": "claude_skill_description_is_trigger", "label": "A skill's frontmatter description is its trigger", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The model reads only name + description to decide whether to invoke the skill, so it is the single most important field and must be specific."}, {"id": "claude_three_tier_shipping", "label": "Three-tier skill shipping gate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheapest first: tier 1 validate/smoke/skill-lint, tier 2 evals (required release gate), tier 3 Harbor behavioural (offered, never assumed). Tiers 1-2 are required because a skill with no floor is ungated forever and unimprovable by whetstone."}, {"id": "claude_never_inject_skills_dir", "label": "Never inject plugins/lirbox/skills into a container", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills keep eval material inside their own dir, so an unpruned inject hands the agent the graders it is scored against \u2014 the answer key lands in its own discovery path. Strip every skill's evals/, harbor/ and arena/ first."}, {"id": "claude_stale_validator_copy", "label": "Grader validator copies go stale silently", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A grader that runs a skill's own validator needs a manual copy inside the task; nothing watches it, so changing the skill's assets/ leaves every copy grading against the old version."}], "edges": [{"source": "claude_lirbox_plugin_marketplace", "target": "readme_lirbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_lirbox_plugin_marketplace", "target": "contributing_marketplace_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_html_artifact_skills", "target": "readme_flowchart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_html_artifact_skills", "target": "readme_codewalk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_html_artifact_skills", "target": "readme_component_diagram", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_html_artifact_skills", "target": "readme_sequence_diagram", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_html_artifact_skills", "target": "readme_plan_deck", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_html_artifact_skills", "target": "readme_pr_writeup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_orchestration_loop_s