{"nodes": [{"id": "_github_workflows_evals_repo_wide_regression_gate", "label": "Repo-wide regression gate (evals workflow)", "file_type": "rationale", "source_file": ".github/workflows/evals.yml", "source_location": "L1-L23", "rationale": "Every skill's frozen acceptance-check is the durable residue of an already-fixed bug. Before this workflow, nothing ran those checks outside a whetstone run targeting that skill, so a fixed bug could silently come back \u2014 conductor's book-under-flag was fixed, verified, merged, then re-accreted across seven runs. The workflow therefore runs EVERY skill's floor and EVERY guarded check on every push and PR, not just the skill under work.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_evals_checks_job", "label": "checks job \u2014 floors + frozen checks (fast gate)", "file_type": "code", "source_file": ".github/workflows/evals.yml", "source_location": "L27-L37", "rationale": "Milliseconds-to-seconds per check, so it is the gate that must never be skipped; runs `node scripts/evals-all.mjs --fast` on node 22 with a 20-minute ceiling.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_evals_nets_job", "label": "nets job \u2014 generator regression nets", "file_type": "code", "source_file": ".github/workflows/evals.yml", "source_location": "L44-L61", "rationale": "Globs plugins/lirbox/skills/*/scripts/test-*.cjs and runs each, accumulating failures instead of bailing on the first, so one run reports every broken generator net. Split from the fast gate because arena's net clones fixture bundles and runs their npm suites, which would otherwise hold up the cheap checks.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_evals_two_job_split", "label": "Two-job split (fast gate vs slow nets)", "file_type": "rationale", "source_file": ".github/workflows/evals.yml", "source_location": "L39-L48", "rationale": "Separating the slow generator nets (30-min timeout) from the fast floors+checks gate (20-min timeout) keeps the must-never-skip gate cheap and fast; concurrency is keyed on github.ref with cancel-in-progress so superseded pushes stop burning runners.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_evals_all_evals_all", "label": "scripts/evals-all.mjs \u2014 repo-wide floors + checks runner", "file_type": "code", "source_file": ".github/workflows/evals.yml", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_evals_checks_job", "target": "scripts_evals_all_evals_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/evals.yml", "source_location": "L37", "weight": 1.0}, {"source": "_github_workflows_evals_repo_wide_regression_gate", "target": "_github_workflows_evals_checks_job", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/evals.yml", "source_location": "L1-L37", "weight": 1.0}, {"source": "_github_workflows_evals_two_job_split", "target": "_github_workflows_evals_nets_job", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/evals.yml", "source_location": "L39-L48", "weight": 1.0}, {"source": "_github_workflows_evals_repo_wide_regression_gate", "target": "plugins_lirbox_skills_conductor_evals_checks_book_under_flag_check_skill_dir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/evals.yml", "source_location": "L6-L8", "weight": 1.0}, {"source": "_github_workflows_evals_nets_job", "target": "plugins_lirbox_skills_conductor_scripts_test_scaffold", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_