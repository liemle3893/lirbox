{"nodes": [{"id": "claude_two_skill_families", "label": "Two skill families (HTML-artifact vs orchestration/loop)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "rationale": "The repo's skills split into two shapes with different conventions: HTML-artifact skills emit one self-contained HTML file (and flowchart ships a headless validator to catch Mermaid label-escaping bugs), while orchestration/loop skills share one backbone \u2014 a deterministic JS conductor driving full-tool worker subagents. Knowing which family a skill belongs to decides which rules apply when editing it.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_conductor_layer_restriction", "label": "Conductor layer is pure JS \u2014 no fs/git/require/Date.now/Math.random", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "The generated loop .js must stay deterministic and side-effect-free so runs are reproducible and resumable; every side-effect lives inside an agent() worker prompt instead. The per-skill test-*.cjs enforce this mechanically with a string scan, so the rule cannot silently erode.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_never_hand_edit_generated_loop", "label": "Never hand-edit a generated loop script", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "Loop scripts come from scripts/scaffold-*.cjs; editing the output instead of the generator reintroduces drift between generator and artifact. The fix is always: change the generator, regenerate with --force.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_regression_net_rule", "label": "Run the regression net after touching a generator", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "Each loop skill's test-*.cjs asserts loop/phase structure, the no-fs scan, and unit helpers \u2014 the mapping is conductor\u2192test-scaffold.cjs, prospector\u2192test-optimize.cjs, whetstone\u2192test-improve.cjs, arena\u2192test-arena.cjs. Running it is what makes a generator change safe.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_non_destructive_default", "label": "Non-destructive default \u2014 loops open PRs, never merge", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "prospector/whetstone finalize by auto-opening a PR with the run report as the body so a human reviews and merges; with no remote they fall back to leaving the branch. Run branches are per-run and timestamped (opt/<goal>-<ts>, improve/<skill>-<ts>) and keyed by run slug \u2014 not by skill/goal \u2014 so concurrent runs never collide on state/config/report/branch/worktree. The whetstone backlog stays keyed by skill (feedback/<skill>.jsonl).", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_runtime_artifacts_gitignored", "label": "Runtime artifacts are gitignored \u2014 never commit them", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "rationale": "Per-run scratch (.workflows/, .optimize/, .improve/, .arena/, .worktrees/, generated *-flowchart/codewalk/plan-deck.html, implementation-notes/) is machine-local noise; committing it would pollute history with non-reproducible state.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_delivery_artifact_exception", "label": "Delivery-artifact exception \u2014 docs/arena/** and docs/changes/** ARE committed", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "Scratch stays ignored, but promoted deliverables must ride the PR so a reviewer can read them: arena's Finalize promotes leaderboard.html + report.md into docs/arena/<name>/, and conductor's Writeup promotes kept implementation-notes/*.html plus writeup.html, design.html and the DocsGate summary.md into docs/changes/<name>/. .gitignore un-ignores both paths (!docs/arena/**, !docs/changes/**).", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_description_is_trigger", "label": "A skill's frontmatter description IS its trigger", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "The description is the only field that decides when Claude invokes the skill, so vagueness there costs invocations no amount of body quality recovers.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_plugin_validate", "label": "claude plugin validate . \u2014 pre-push marketplace validation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_lirbox_namespace", "label": "Skills resolve under the lirbox: namespace", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_query_first", "label": "graphify query-first rule for codebase questions", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "rationale": "graphify query/path/explain return a scoped subgraph that is usually far smaller than GRAPH_REPORT.md or raw grep output, so querying first saves context; the wiki index serves broad navigation, GRAPH_REPORT.md only broad architecture review. `graphify update .` after code changes is AST-only and costs no API calls.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_codewalk_skill_codewalk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_flowchart_skill_flowchart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_component_diagram_skill_component_diagram", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_sequence_diagram_skill_sequence_diagram", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_plan_deck_skill_plan_deck", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_pr_writeup_skill_pr_writeup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_deep_understanding_skill_deep_understanding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_flowchart_assets_validate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_two_skill_families", "target": "plugins_lirbox_skills_conductor_skill_conductor", "relation": "references", "confidence"